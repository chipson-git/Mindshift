# --- Supabase (optional) ---
# Leave these empty to run in DEMO mode: no real accounts, data lives in a browser cookie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to change a user's plan (demo checkout / payment webhooks). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (optional) ---
# Without a key the AI coach and meditation generator return sample (canned) answers.
ANTHROPIC_API_KEY=
# Model used for the coach and the meditation generator.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments ---
# "demo" = checkout just switches the plan, no money moves. Real provider (TBC / BOG / Lemon Squeezy) comes later.
PAYMENTS_MODE=demo
